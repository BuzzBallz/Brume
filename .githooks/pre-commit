#!/bin/sh
# Refuse commits that stage an .env file or key material. Enable once per clone: git config core.hooksPath .githooks
if git diff --cached --name-only | grep -E '(^|/)\.env' | grep -v '\.env\.example$'; then
  echo "pre-commit: .env file staged" >&2; exit 1
fi
if git diff --cached -U0 -- . ':!.githooks' | grep -E '^\+' | grep -Eq 'ed25519e?_sk1|xprv1|addr_sk1|(mainnet|preprod)[A-Za-z0-9]{32}'; then
  echo "pre-commit: key material in staged diff" >&2; exit 1
fi
