# Names only. Real values go in .env, never committed.
BLOCKFROST_MAINNET_PROJECT_ID=
BLOCKFROST_PREPROD_PROJECT_ID=
# Preprod wallets: bech32 root key, prefix "xprv" (CIP-1852 account 0 / key 0). Never a mnemonic: the pre-commit hook would not catch it.
PREPROD_BUYER_SKEY=
PREPROD_SELLER_SKEY=
PREPROD_ADMIN_SKEY=
# Switches (PLAN §9)
READ_SOURCE=live
SUBMIT_VIA=koios
SETTLE_PATH=B
SIGNER=file
HIRE_VIA=sokosumi
X402=off
HIRE_VIA=direct            # sokosumi = /start_job opens a Masumi payment
PAYMENT_SERVICE_URL=       # e.g. http://localhost:3001/api/v1
PAYMENT_API_KEY=
AGENT_IDENTIFIER=