# Names only. Real values go in .env, never committed.
BLOCKFROST_MAINNET_PROJECT_ID=
BLOCKFROST_PREPROD_PROJECT_ID=
# Koios token (koios.rest, free tier): lifts the keyless daily cap on preprod; sent as Authorization: Bearer
KOIOS_PREPROD_API_TOKEN=
# Preprod wallets: bech32 root key, prefix "xprv" (CIP-1852 account 0 / key 0). Never a mnemonic: the pre-commit hook would not catch it.
PREPROD_BUYER_SKEY=
PREPROD_SELLER_SKEY=
PREPROD_ADMIN_SKEY=
# Masumi payment service (part 5c)
HIRE_VIA=direct            # sokosumi = opens one Masumi payment per /start_job
PAYMENT_SERVICE_URL=       # e.g. http://localhost:3001/api/v1
PAYMENT_API_KEY=
AGENT_IDENTIFIER=
# Switches (PLAN §9)
READ_SOURCE=live
SUBMIT_VIA=koios
SETTLE_PATH=B
SIGNER=file
X402=off
